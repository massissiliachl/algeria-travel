REACT_APP_API_URL=
# Laisser vide en local si vous utilisez npm start (proxy /api → port 5000).
# Si vous ouvrez le site sur Render/prod, l'API utilise automatiquement le même domaine.
REACT_APP_SITE_URL=https://algeriatravel.com

# --- Render (production) ---
# Option A — 1 seul service Web (API + React, voir render.yaml) :
#   REACT_APP_API_URL=   (vide → même domaine que le site)
#   SERVE_FRONTEND=true sur le backend
#   FRONTEND_URL=https://VOTRE-SERVICE.onrender.com
#   SITE_URL=https://VOTRE-SERVICE.onrender.com
#
# Option B — 2 services (frontend static + backend séparés) :
#   REACT_APP_API_URL=https://VOTRE-API.onrender.com
#   (variable définie au BUILD sur Render, pas seulement au runtime)

# Firebase (Console → Paramètres projet → Vos applications → Config)
