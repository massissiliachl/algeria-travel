{
  "name": "algeria-travel",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:5000",
  "dependencies": {
    "firebase": "^12.17.1",
    "lucide-react": "^1.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.30.4",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "react-scripts start",
    "start:api": "node backend/server.js",
    "build": "node scripts/sync-brand-icons.js && node scripts/generate-sitemap.js && react-scripts build",
    "sync:icons": "node scripts/sync-brand-icons.js",
    "build:render": "npm run build && cd admin && npm install && npm run build",
    "postinstall": "cd backend && npm install",
    "migrate:render": "node scripts/render-migrate.js",
    "eject": "react-scripts eject"
  },
  "main": "backend/server.js",
  "engines": {
    "node": ">=18"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
