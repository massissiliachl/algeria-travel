Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Une seule adresse : https://algeriatravel.org
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} !https [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://algeriatravel.org%{REQUEST_URI} [R=301,L]

# /pages/index.html → /
RewriteCond %{THE_REQUEST} \s/pages/index\.html[\s?]
RewriteRule ^pages/index\.html$ / [R=301,L]

# /pages/tours.html → /tours.html
RewriteCond %{THE_REQUEST} \s/pages/([a-z-]+\.html)
RewriteRule ^pages/([a-z-]+\.html)$ /$1 [R=301,L]

# Anciennes adresses du site React
RewriteRule ^(destinations|activities|stays|tours|blog|search|gallery|contact)/?$ /$1.html [R=301,L]
RewriteRule ^place/([^/]+)/?$ /place.html?id=$1 [R=301,L,QSA]
RewriteRule ^activity/([^/]+)/?$ /activity.html?id=$1 [R=301,L,QSA]
RewriteRule ^blog/([^/]+)/?$ /article.html?slug=$1 [R=301,L,QSA]
RewriteRule ^(hotels|guesthouses)/?$ /stays.html?view=$1 [R=301,L,QSA]

# /tours.html affiche pages/tours.html sans changer l'adresse
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([a-z-]+\.html)$ pages/$1 [L]
