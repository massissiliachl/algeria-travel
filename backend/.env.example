PORT=5000
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Render backend : https://algeria-travel-7i7y.onrender.com
# FRONTEND_URL=https://algeria-travel-1.onrender.com
# SITE_URL=https://algeria-travel-1.onrender.com
# SERVE_FRONTEND=false
# SERVE_FRONTEND=true
# CORS_ORIGINS=https://VOTRE-ADMIN.onrender.com

# Utilisez l'URL "Connection pooler" (port 6543) depuis Supabase → Connect
DATABASE_URL=postgresql://postgres.VOTRE_PROJECT_ID:VOTRE_MOT_DE_PASSE@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

ADMIN_URL=http://localhost:5173

# Clé secrète pour consulter / gérer les réservations (routes /api/admin/*)
ADMIN_API_KEY=changez-moi-en-production

  JWT_SECRET=changez-moi-jwt-en-production
  JWT_EXPIRES_IN=30d

  # URL portail partenaire hôtel (dev: npm run dev dans partner/)
  PARTNER_URL=http://localhost:5175

# Max demandes par IP par heure
RESERVATION_RATE_LIMIT=5
CONTACT_RATE_LIMIT=5
CHAT_RATE_LIMIT=40

# Chatbot IA (optionnel — sans clé, réponses locales basées sur le catalogue)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=25000

# Emails (Gmail : créez un mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=travelalgeriadz@gmail.com
SMTP_PASS=votre-mot-de-passe-application
MAIL_FROM=Algeria Travel <travelalgeriadz@gmail.com>
ADMIN_EMAIL=travelalgeriadz@gmail.com

# Notifications push (générer avec: node scripts/generate-vapid.js)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:travelalgeriadz@gmail.com

