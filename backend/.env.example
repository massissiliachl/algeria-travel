PORT=5000
FRONTEND_URL=http://localhost:3000

# Utilisez l'URL "Connection pooler" (port 6543) depuis Supabase → Connect
# La connexion directe db.xxx.supabase.co:5432 peut timeout (IPv6)
DATABASE_URL=postgresql://postgres.VOTRE_PROJECT_ID:VOTRE_MOT_DE_PASSE@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

ADMIN_URL=http://localhost:5173

# Clé secrète pour consulter / gérer les réservations (routes /api/admin/*)
ADMIN_API_KEY=changez-moi-en-production

# Max demandes de réservation par IP par heure
RESERVATION_RATE_LIMIT=5

# Notifications push (générer avec: node scripts/generate-vapid.js)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:Algeria.travel@gmail.com
